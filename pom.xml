<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.github.vishuraj</groupId>
    <artifactId>securetest-parent</artifactId>
    <version>1.0.2</version>
    <packaging>pom</packaging>
    <name>SecureTest AI :: Parent</name>
    <description>Plug-and-play quality, security, performance, compliance and modernization platform for Spring Boot.</description>
    <url>https://github.com/vishuraj/securetest-ai</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>vishuraj</id>
            <name>Arvind</name>
            <url>https://github.com/vishuraj</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/vishuraj/securetest-ai</url>
        <connection>scm:git:https://github.com/vishuraj/securetest-ai.git</connection>
        <developerConnection>scm:git:git@github.com:vishuraj/securetest-ai.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/vishuraj/securetest-ai/issues</url>
    </issueManagement>

    <modules>
        <module>securetest-bom</module>
        <module>securetest-core</module>
        <module>securetest-reporting</module>
        <module>securetest-adapters</module>
        <module>securetest-migration-engine</module>
        <module>securetest-ai</module>
        <module>securetest-dashboard-ui</module>
        <module>securetest-spring-boot-autoconfigure</module>
        <module>securetest-spring-boot-starter</module>
        <module>securetest-control-plane</module>
        <module>securetest-worker</module>
        <module>securetest-sample-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <central.autoPublish>false</central.autoPublish>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Mirrors securetest-bom (a BOM cannot be imported from inside its own reactor). -->
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-core</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-reporting</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-adapters</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-migration-engine</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-ai</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-dashboard-ui</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-spring-boot-autoconfigure</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-spring-boot-starter</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-control-plane</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-worker</artifactId><version>${project.version}</version></dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>17</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Maven Central release: mvn -Prelease deploy
          Needs a 'central' server (Central Portal user token) in settings.xml and a GPG key; see RELEASING.md.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                            <release>17</release>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- false = the deployment waits in the Central Portal for a manual "Publish" click -->
                            <autoPublish>${central.autoPublish}</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <deploymentName>SecureTest ${project.version}</deploymentName>
                            <!-- applications, not libraries: shipped as container images instead -->
                            <excludeArtifacts>
                                <excludeArtifact>securetest-sample-app</excludeArtifact>
                                <excludeArtifact>securetest-control-plane</excludeArtifact>
                                <excludeArtifact>securetest-worker</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
