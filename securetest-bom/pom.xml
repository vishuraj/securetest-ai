<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Deliberately has no parent so consumers importing the BOM inherit nothing else (e.g. Spring Boot's versions). -->
    <groupId>io.github.vishuraj</groupId>
    <artifactId>securetest-bom</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>SecureTest AI :: BOM</name>
    <description>Version alignment for SecureTest modules.</description>
    <url>https://github.com/vishuraj/securetest-ai</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>vishuraj</id>
            <name>Arvind</name>
            <url>https://github.com/vishuraj</url>
        </developer>
    </developers>
    <scm>
        <url>https://github.com/vishuraj/securetest-ai</url>
        <connection>scm:git:https://github.com/vishuraj/securetest-ai.git</connection>
        <developerConnection>scm:git:git@github.com:vishuraj/securetest-ai.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <central.autoPublish>false</central.autoPublish>
    </properties>

    <!-- Only the published libraries; the control plane and worker ship as container images. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-core</artifactId><version>1.0.0</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-reporting</artifactId><version>1.0.0</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-adapters</artifactId><version>1.0.0</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-migration-engine</artifactId><version>1.0.0</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-ai</artifactId><version>1.0.0</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-dashboard-ui</artifactId><version>1.0.0</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-spring-boot-autoconfigure</artifactId><version>1.0.0</version></dependency>
            <dependency><groupId>io.github.vishuraj</groupId><artifactId>securetest-spring-boot-starter</artifactId><version>1.0.0</version></dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>${central.autoPublish}</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <deploymentName>SecureTest ${project.version}</deploymentName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
