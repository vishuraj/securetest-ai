<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.vishuraj</groupId>
        <artifactId>securetest-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>securetest-sample-app</artifactId>
    <name>SecureTest AI :: Sample App</name>
    <description>A plain Spring Boot app that only adds the starter dependency.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== The only line needed to get the SecureTest dashboard ===== -->
        <dependency>
            <groupId>io.github.vishuraj</groupId>
            <artifactId>securetest-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- remote-scan end-to-end test: control plane + worker run in the test JVM -->
        <dependency>
            <groupId>io.github.vishuraj</groupId>
            <artifactId>securetest-control-plane</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.vishuraj</groupId>
            <artifactId>securetest-worker</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>build-info</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
